# Agent key from /admin/agent-keys — required for the `coconut` arm (headless MCP).
COCO_AGENT_KEY=

# Org slug, required on multi-tenant deployments (the API answers
# "missing_org_context" without it). It is the org segment of your admin URL.
COCO_ORG_SLUG=

# Optional. If unset, the harness hydrates page metadata through the already
# authenticated `coconut` CLI instead of the SDK.
COCO_API_KEY=
COCO_BASE_URL=https://api.coconut.md
